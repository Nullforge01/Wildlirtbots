# ── Owner ────────────────────────────────────────────────────────────────
# Your WhatsApp number, digits only, no "+". Used for owner-only commands
# (e.g. the nullforge admin panel). No hidden bypass — this is the only
# thing that grants owner access.
OWNER_NUMBER=

# ── Optional API keys ───────────────────────────────────────────────────
# Every key below is optional. Commands that need a key you haven't set
# will just reply that the feature isn't configured, instead of failing.
GITHUB_TOKEN=
TG_TOKEN=
PAXSENIX_API_KEY=
OPENAI_API_KEY=
TMDB_API_KEY=
NEWS_API_KEY=
GIFTED_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
NEWSLETTER_JID=
GROUP_INVITE_LINK=
PORT=3000
